<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.ii2.hvaccrm"
    android:versionCode="3"
    android:versionName="0.1.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 故意不声明 CAMERA：本 App 用 ACTION_IMAGE_CAPTURE 交给系统相机，
         一旦自己声明了 CAMERA 权限，就反而必须做运行时授权，系统相机会拒绝调用。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ⚠️ targetSdk>=30 的包可见性限制：不声明这里，resolveActivity() 对相机/文件选择器
         永远返回 null，App 会误判"设备没有相机"从而不显示拍照入口。真机上必踩。 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/SettingsTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- 给系统相机写照片用的最小 ContentProvider（替代 AndroidX 的 FileProvider） -->
        <provider
            android:name=".SimpleFileProvider"
            android:authorities="cn.ii2.hvaccrm.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>

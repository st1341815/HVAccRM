# ---- HVAccRM（暖通空调客户管理系统）运行配置（复制为 .env 后按需修改）----
# 界面/文档里展示的系统名（默认值即可，改这里可换品牌名）
APP_NAME=暖通空调客户管理系统
APP_NAME_EN=HVAccRM

# 必填：会话签名密钥，生成方式 python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# ⚠️ docker compose 会校验此变量（${APP_SECRET_KEY:?...}），未设置会直接报错退出。
#    推荐直接运行 bash scripts/gen_env.sh 一键生成 .env（随机密钥 + 随机初始密码）。
APP_SECRET_KEY=change-me-please

# 首次启动时创建 admin 账号（仅第一次生效，之后改密码走系统页面）
ADMIN_USER=admin
ADMIN_PASS=change-me-please
# 设为 true 则 admin 首次登录后强制修改密码（生产建议 true）
ADMIN_FORCE_PASSWORD_CHANGE=false

# 路径（容器内）
DB_PATH=/data/crm.db
DATA_DIR=/data
CONFIG_DIR=/config

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 会话有效期（秒），默认 12 小时
SESSION_MAX_AGE=43200

# 照片缩略图
THUMB_MAX_EDGE=1280
THUMB_QUALITY=80

# 备份保留份数
BACKUP_KEEP=30

# ---- HVAccRM（暖通空调客户管理系统）运行配置示例 ----
# 复制为 .env 后按需修改；不复制也能用默认值直接启动。
# 界面/文档里展示的系统名（默认值即可，改这里可换品牌名）
APP_NAME=暖通空调客户管理系统
APP_NAME_EN=HVAccRM

# 会话签名密钥：默认值即可直接启动。
# ⚠️ 若通过公网访问，建议改成随机值：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-insecure-change-me

# 首次启动时创建 admin 账号（仅第一次生效，之后改密码走系统页面）
ADMIN_USER=admin
# 默认密码 admin888（首次登录后建议在「账户」页修改）
ADMIN_PASS=admin888
# 设为 true 则 admin 首次登录后强制修改密码（公网部署建议 true）
ADMIN_FORCE_PASSWORD_CHANGE=false

# 路径（容器内）
DB_PATH=/data/crm.db
DATA_DIR=/data
CONFIG_DIR=/config

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 会话有效期（秒），默认 12 小时
SESSION_MAX_AGE=43200

# 照片缩略图
THUMB_MAX_EDGE=1280
THUMB_QUALITY=80

# 备份保留份数
BACKUP_KEEP=30

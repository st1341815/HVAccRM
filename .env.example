# ---- HVAccRM（暖通空调客户管理系统）运行配置示例 ----
# 复制为 .env 后按需修改；不复制也能用默认值直接启动。
# 界面/文档里展示的系统名（默认值即可，改这里可换品牌名）
APP_NAME=暖通空调客户管理系统
APP_NAME_EN=HVAccRM

# 会话签名密钥。
# 留空/保持默认值 = 首次启动自动生成随机密钥并保存到 <CONFIG_DIR>/.app_secret（0600），
# 开箱即用且不会是全网同一把钥匙；多副本/多容器共享会话时，必须显式填同一个值：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# 首次启动时创建 admin 账号（仅第一次生效，之后改密码走系统页面）
ADMIN_USER=admin
# 留空/保持 admin888 = 首次启动生成随机密码，写入 <DATA_DIR>/first_boot.txt（0600），
# 首次登录会强制改密；显式填写则以填写值为初始密码。
ADMIN_PASS=
# 设为 true 则 admin 首次登录后强制修改密码（公网部署建议 true）
ADMIN_FORCE_PASSWORD_CHANGE=false

# 路径（容器内）
DB_PATH=/data/crm.db
DATA_DIR=/data
CONFIG_DIR=/config

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 会话有效期（秒），默认 12 小时
SESSION_MAX_AGE=43200

# Cookie 的 Secure 标志：auto（判定为 https 才加）/ 1 / 0。
# 反代终止 TLS 时按 X-Forwarded-Proto 判定；判定不出来就按 auto 的保守行为（不加），避免内网 http 登不上。
COOKIE_SECURE=auto
# >0 时下发 HSTS（秒）。默认关闭——HSTS 更适合在反代层统一加。
HSTS_MAX_AGE=0

# 是否暴露 /api/docs、/api/openapi.json、/redoc（默认关闭）
API_DOCS=false

# 照片缩略图
THUMB_MAX_EDGE=480
THUMB_QUALITY=80

# 备份保留份数
BACKUP_KEEP=30

# 登录限速：IP+账号维度的失败次数/锁定时长；账号维度阈值（防伪造 XFF 绕过）
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_ACCOUNT=20
LOGIN_LOCK_SECONDS=300

# 对外访问地址（反代/域名场景填这里，用于生成分享链接、og:image、二维码内容）
# 例：https://<your-domain>:8443 ；留空则按请求头自动推断（反代终止 TLS 时可能推成 http）
PUBLIC_BASE_URL=
